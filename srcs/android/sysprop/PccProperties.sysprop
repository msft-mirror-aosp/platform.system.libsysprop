owner: Platform
module: "android.sysprop.PccProperties"

prop {
    api_name: "audit_mode_enabled"
    prop_name: "persist.pcc.audit_mode.enabled"
    type: Boolean
    scope: Internal
    access: ReadWrite
}

prop {
    api_name: "audit_mode_max_log_files"
    prop_name: "persist.pcc.audit_mode.max_log_files"
    type: Integer
    scope: Internal
    access: ReadWrite
}

prop {
    api_name: "audit_mode_log_file_max_size_kb"
    prop_name: "persist.pcc.audit_mode.log_file_max_size_kb"
    type: Integer
    scope: Internal
    access: ReadWrite
}

